<Window x:Class="AcademicDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AcademicDesktop" Title="知汇 · 学术成果工作台" Icon="Assets/zhihui.ico" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" AllowsTransparency="False" Width="1200" Height="700" MinWidth="960" MinHeight="560" FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F3F6F8" Foreground="#172D3A" WindowStartupLocation="Manual" Loaded="WindowLoaded" PreviewKeyDown="WindowKeyDown" SizeChanged="WindowSizeChanged">
  <Grid Background="#F3F6F8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#142F3A"><DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="26,28,20,26"><StackPanel Orientation="Horizontal"><Image Source="Assets/zhihui.png" Width="40" Height="40" Margin="-4,0,9,0"/><TextBlock Text="知 汇" FontSize="28" FontWeight="Bold" Foreground="White"/></StackPanel><TextBlock Text="ACADEMIC WORKSPACE" FontSize="10" Foreground="#8CA9B6" Margin="0,7,0,0"/><Border Height="3" Width="30" Background="#48B8AB" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="25,20"><TextBlock Text="GROUP 02   /   DESKTOP" FontSize="10" Foreground="#88A7B3"/><TextBlock Text="Windows 原生客户端 · v0.3" FontSize="11" Foreground="#88A7B3" Margin="0,8,0,0"/><TextBlock x:Name="SidebarUser" Text="访客模式" Foreground="#D3E0E6" Margin="0,20,0,4" TextWrapping="Wrap"/><Button x:Name="SessionButton" Content="登录 / 注册" Click="ChangeSession" Background="Transparent" Foreground="#9AD6CB" Padding="0,8" HorizontalContentAlignment="Left" Margin="0"/></StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation"/></ScrollViewer>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="28,18,28,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="ServerAddress" Text="http://127.0.0.1:8080" Style="{StaticResource Caption}"/><Button Content="重新连接" Style="{StaticResource Secondary}" Click="Connect" Margin="8,0,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Fill="#9EB0B8" Width="7" Height="7" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionText" Text="等待连接" Style="{StaticResource Caption}"/><TextBlock Text="  /  学术成果检索与分享平台" Style="{StaticResource Caption}"/></StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="成果发现" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="从一项成果出发，发现知识与人的连接。" Foreground="#687F89" Margin="0,8,0,0"/></StackPanel>
        <StackPanel x:Name="ScopeSelector" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="数据范围" Margin="0,0,10,0" Foreground="#687F89"/><ComboBox x:Name="Dataset" Width="160" SelectedIndex="0" SelectionChanged="DatasetChanged"><ComboBoxItem Content="课程模拟资料" Tag="demo"/><ComboBoxItem Content="真实资料" Tag="real"/></ComboBox></StackPanel>
      </Grid>
      <Border x:Name="Banner" Grid.Row="2" Background="#FFF2D9" CornerRadius="6" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="#80591B"/></Border>
      <TabControl x:Name="Pages" SelectionChanged="PageSelectionChanged" Grid.Row="3" SelectedIndex="0" BorderThickness="0" Background="Transparent">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid><TextBox x:Name="SearchText" AutomationProperties.Name="成果关键词" ToolTip="题名、摘要、作者、期刊、DOI 或编号；空格分隔条件采用 AND" KeyDown="SearchKey"/><TextBlock Text="输入题名、作者、期刊、DOI 或编号…" Foreground="#8A9CA4" Margin="11,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                  <ComboBox x:Name="WorkType" Grid.Column="1" Margin="8,0" SelectedIndex="0"><ComboBoxItem Content="全部类型" Tag=""/><ComboBoxItem Content="论文" Tag="PAPER"/><ComboBoxItem Content="授权专利" Tag="PATENT"/><ComboBoxItem Content="科研项目" Tag="PROJECT"/><ComboBoxItem Content="获奖" Tag="AWARD"/></ComboBox>
                  <ComboBox x:Name="Sort" Grid.Column="2" SelectedIndex="0"><ComboBoxItem Content="相关度优先" Tag="relevance"/><ComboBoxItem Content="年份优先" Tag="year"/><ComboBoxItem Content="引用优先" Tag="citations"/><ComboBoxItem Content="题名字序" Tag="title"/></ComboBox>
                  <Button x:Name="SearchButton" Grid.Column="3" Content="检索成果" Click="SearchClick" Margin="10,0,0,0" Padding="22,10"/>
                </Grid>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/><ColumnDefinition Width="20"/><ColumnDefinition Width="74"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="InstitutionFilter" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,8,0" ToolTip="成果发生时的机构"/>
                  <ComboBox x:Name="ScholarFilter" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,0,8,0" ToolTip="按独立人物 ID 筛选"/>
                  <ComboBox x:Name="FieldFilter" Grid.Column="2" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,8,0"/>
                  <TextBox x:Name="YearFrom" Grid.Column="3" ToolTip="起始年"/><TextBlock Grid.Column="4" Text="—" HorizontalAlignment="Center"/><TextBox x:Name="YearTo" Grid.Column="5" ToolTip="截止年"/>
                  <Button Grid.Column="6" Content="重置" Click="ResetSearch" Style="{StaticResource Secondary}" Margin="8,0,0,0"/>
                </Grid>
              </StackPanel>
            </Border>
            <DockPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock x:Name="ResultSummary" Text="连接服务后开始探索" FontWeight="SemiBold"/><TextBlock x:Name="ReleaseText" Text="" Foreground="#71858D" HorizontalAlignment="Right"/></DockPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
              <ListBox x:Name="WorkList" Background="Transparent" BorderThickness="0" SelectionChanged="WorkSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="White" BorderBrush="#E0E8EC" BorderThickness="1" CornerRadius="9" Padding="16"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#087F78"/><Setter TargetName="ItemBorder" Property="Background" Value="#F0FAF8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#70B9AE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><StackPanel><StackPanel Orientation="Horizontal"><Border Background="#E9F3F3" CornerRadius="3" Padding="7,3"><TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="#24776F"/></Border><TextBlock Text="{Binding DateLabel}" Margin="10,0,0,0" FontSize="11" Foreground="#70858D"/></StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,7"/><TextBlock Text="{Binding People}" Foreground="#4D6874" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Footer}" FontSize="11" Foreground="#84959D" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DetailPanel"><TextBlock Text="成果详情" Style="{StaticResource SectionTitle}"/><TextBlock Text="选中一项成果，查看题录、贡献角色、类型字段与来源。" Style="{StaticResource Caption}"/></StackPanel></ScrollViewer></Border>
            </Grid>
            <DockPanel Grid.Row="3" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一页" x:Name="PreviousPage" Click="Previous" Style="{StaticResource Secondary}"/><TextBlock x:Name="PageNumber" Text="1" Margin="8,0,16,0"/><Button Content="下一页" x:Name="NextPage" Click="Next" Style="{StaticResource Secondary}" Margin="0"/></StackPanel><TextBlock Text="模拟资料仅用于课程演示；引用缺失与零值分别显示。" Style="{StaticResource Caption}"/></DockPanel>
          </Grid>
        </TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="查找学者" Click="LoadScholarsClick" Margin="12,0,0,0"/><TextBox x:Name="ScholarSearch" ToolTip="姓名或学者 ID"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><DataGrid x:Name="ScholarsGrid" SelectionChanged="ScholarSelected"><DataGrid.Columns><DataGridTextColumn Header="学者" Binding="{Binding Name}" Width="100"/><DataGridTextColumn Header="独立标识" Binding="{Binding Id}" Width="90"/><DataGridTextColumn Header="当前机构" Binding="{Binding InstitutionName}" Width="*"/><DataGridTextColumn Header="门户" Binding="{Binding ClaimLabel}" Width="80"/></DataGrid.Columns></DataGrid><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="ScholarName" Text="独立人物，准确关联" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ScholarBio" Text="同名人物以独立标识区分。门户管理权与成果贡献分别审核。" Style="{StaticResource Caption}" Margin="0,8,0,20"/><Button Content="查看此人的成果" Click="ScholarWorks" Margin="0,0,0,12"/><Button x:Name="PublicPortalApply" Content="申请管理此门户" Click="ClaimPortal" Margin="0,12,0,0"/></StackPanel></Border></Grid></Grid></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="刷新统计" Click="StatsClick" Margin="0"/><TextBlock x:Name="StatsContext" Text="全库分类统计 · 同版目录" Style="{StaticResource Caption}"/></DockPanel><UniformGrid Columns="4" x:Name="MetricCards" Margin="0,0,-12,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="成果类型" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="TypeChart"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="年度分布" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="YearChart"/></StackPanel></Border></Grid><Grid Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="机构成果数量" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="InstitutionChart"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="领域分布" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="FieldChart"/></StackPanel></Border></Grid><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="词项热点" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="HotspotSummary" Style="{StaticResource Caption}" Margin="0,0,0,12"/><StackPanel x:Name="HotspotChart"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="热点年度变化" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="HotspotTerm" SelectionChanged="HotspotTermChanged" Margin="0,0,0,12"/><StackPanel x:Name="HotspotTrendChart"/></StackPanel></Border>
          </Grid><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="数据覆盖说明" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="CoverageNotes" Style="{StaticResource Caption}"/></StackPanel></Border><TextBlock x:Name="StatisticsNotes" Style="{StaticResource Caption}"/></StackPanel></ScrollViewer></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="寻找两位学者间的共著联系" Style="{StaticResource SectionTitle}"/><TextBlock Text="仅使用已识别人物及论文署名关系。路径上的每条连接都有论文证据。" Style="{StaticResource Caption}" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="GraphStart" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center"/><ComboBox Grid.Column="2" x:Name="GraphEnd" DisplayMemberPath="Label" SelectedValuePath="Id"/><Button Grid.Column="3" Content="寻找最短路径" Click="FindPath" Margin="12,0,0,0"/></Grid></StackPanel></Border><TextBlock x:Name="GraphMessage" Grid.Row="1" Text="最多六跳；只反映当前数据集，不能解释为全部学术合作。" Margin="0,16" Style="{StaticResource Caption}"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><WrapPanel x:Name="GraphPath" Margin="0,0,0,20"/><StackPanel x:Name="GraphEvidence"/></StackPanel></ScrollViewer></Grid></TabItem>
        <!-- 4: shared guest / researcher profile -->
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,18"><DockPanel>
            <local:SvgIcon Source="Assets/avatar-default.svg" Width="96" Height="96" DockPanel.Dock="Left" Margin="0,0,24,0"/>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ProfileName" Text="未登录" FontSize="27" FontWeight="SemiBold"/>
              <TextBlock x:Name="ProfileRole" Style="{StaticResource Caption}" Margin="0,8,0,12"/>
              <Button x:Name="GuestLogin" Content="登录 / 注册" Click="ChangeSession" HorizontalAlignment="Left"/>
              <Button x:Name="EditProfileButton" Content="编辑个人资料" Click="EditProfile" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Visibility="Collapsed"/>
            </StackPanel>
          </DockPanel></Border>
          <StackPanel x:Name="ProfileFields" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><DockPanel><Button DockPanel.Dock="Right" Content="学术门户认证" Click="OpenCertification" Style="{StaticResource Secondary}" Margin="20,0,0,0"/><StackPanel><TextBlock Text="学术门户认证信息" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="CertificationSummary" Style="{StaticResource Caption}"/></StackPanel></DockPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="ORCID" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ProfileOrcid" Text="尚未填写" Style="{StaticResource Caption}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="我的网站" Style="{StaticResource SectionTitle}"/><WrapPanel x:Name="WebsiteLinks"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="关于我" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ProfileAbout" TextWrapping="Wrap"/></StackPanel></Border>
          </StackPanel>
          <Border x:Name="ProfileEditor" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="编辑个人资料" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="姓名" Margin="0,12,0,6"/><TextBox x:Name="EditName" MaxLength="100"/>
            <TextBlock Text="ORCID（可选）" Margin="0,12,0,6"/><TextBox x:Name="EditOrcid" MaxLength="19" ToolTip="例如 0000-0002-1825-0097"/>
            <TextBlock Text="我的网站（每行一个：名称 | https://网址）" Margin="0,12,0,6"/><TextBox x:Name="EditWebsites" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="18000"/>
            <TextBlock Text="关于我 · 研究方向、成就与个人介绍" Margin="0,12,0,6"/><TextBox x:Name="EditAbout" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="保存资料" Click="SaveProfile"/><Button Content="取消" Click="CancelProfileEdit" Style="{StaticResource Secondary}"/></StackPanel>
          </StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <!-- 5: verified personal outcomes -->
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="刷新" Click="RefreshMine" Style="{StaticResource Secondary}"/><TextBlock x:Name="MyWorksSummary" Text="审核通过的成果将在这里展示" Style="{StaticResource Caption}"/></DockPanel>
          <DataGrid x:Name="MyWorks" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="成果名称" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="110"/><DataGridTextColumn Header="年份" Binding="{Binding DateLabel}" Width="100"/><DataGridTextColumn Header="贡献角色" Binding="{Binding ConfirmedRole}" Width="110"/></DataGrid.Columns></DataGrid>
          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="申请撤销本人关联" Click="RevokeOutcome" Style="{StaticResource Secondary}"/><StackPanel><TextBlock Text="还没有找到你的成果？" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,0"><Hyperlink Click="NewOutcomeApplication">申报成果 → 前往我的申请</Hyperlink></TextBlock></StackPanel></DockPanel></Border>
        </Grid></TabItem>
        <!-- 6: private applications and inline composer -->
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MinHeight="650"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="撰写成果申请" Click="NewOutcomeApplication"/><Button Content="门户认证申请" Click="OpenCertification" Style="{StaticResource Secondary}"/><Button Content="刷新" Click="RefreshMine" Style="{StaticResource Secondary}"/></StackPanel><TextBlock Text="只展示归属于当前账号的申请" Style="{StaticResource Caption}"/></DockPanel>
          <Border x:Name="ApplicationComposer" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,12" Padding="16"><StackPanel>
            <DockPanel><Button DockPanel.Dock="Right" Content="收起" Click="CloseComposer" Style="{StaticResource Secondary}" Padding="12,5"/><TextBlock Text="撰写申请 · 成果申领" FontSize="17" FontWeight="SemiBold"/></DockPanel>
            <TextBlock Text="检索公共目录中的成果，说明你的贡献与可核验的证明。" Style="{StaticResource Caption}" Margin="0,8"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="检索" Click="FindApplicationWorks" Margin="8,0,0,0"/><TextBox x:Name="ApplicationSearch" ToolTip="题名、DOI 或编号" KeyDown="ApplicationSearchKey"/></DockPanel>
            <ComboBox x:Name="ApplicationWork" DisplayMemberPath="Title" Margin="0,8" ToolTip="选择一项成果"/>
            <TextBox x:Name="ApplicationEvidence" Height="72" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="填写本人贡献、署名位置以及公开证据链接"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="提交成果申请" Click="SubmitOutcomeApplication"/><TextBlock x:Name="ApplicationSearchInfo" Style="{StaticResource Caption}"/></StackPanel>
          </StackPanel></Border>
          <DataGrid x:Name="MyClaims" Grid.Row="2" MinHeight="90" SelectionChanged="MyClaimSelected"><DataGrid.Columns><DataGridTextColumn Header="申请类型" Binding="{Binding KindLabel}" Width="135"/><DataGridTextColumn Header="目标" Binding="{Binding TargetLabel}" Width="*"/><DataGridTextColumn Header="阶段 / 操作" Binding="{Binding StageLabel}" Width="110"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="115"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="ClaimsPrevious" Content="上一页" Click="ClaimsPage" Tag="-1" Style="{StaticResource Secondary}"/><TextBlock x:Name="ClaimsPageInfo" Margin="8,0,16,0"/><Button x:Name="ClaimsNext" Content="下一页" Click="ClaimsPage" Tag="1" Style="{StaticResource Secondary}"/></StackPanel>
          <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"><StackPanel><TextBlock x:Name="MyClaimReason" Text="选择申请以查看意见。补充材料仅本人和审核员可见。" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="SupplementEvidence" Height="60" MaxLength="8000" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="ResubmitClaim" Content="提交草稿 / 补充重提" Tag="SUBMIT" Click="MineAction" IsEnabled="False"/><Button x:Name="WithdrawClaim" Content="撤回申请" Tag="WITHDRAW" Click="MineAction" Style="{StaticResource Secondary}" IsEnabled="False"/></StackPanel></StackPanel></Border>
        </Grid></ScrollViewer></TabItem>
        <!-- 7: source collection, catalog, legacy imports and quality share the database workspace. -->
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="从公开来源采集题录，保留原文、更新记录与公开版本。" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
          <TabControl x:Name="AdminCatalogTabs" Grid.Row="1" SelectedIndex="0" SelectionChanged="AdminCatalogTabChanged">
            <TabItem Header="来源采集"><ScrollViewer x:Name="CrawlContentScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,10">
              <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14"><StackPanel>
                <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox x:Name="CrawlAutoRefresh" Content="每 5 秒刷新" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="刷新任务" Click="RefreshCrawl" Style="{StaticResource Secondary}" Margin="0"/></StackPanel><TextBlock TextWrapping="Wrap" Text="Crossref · 真实学术题录" FontSize="18" FontWeight="SemiBold"/></DockPanel>
                <TextBlock x:Name="CrawlSourceSummary" Style="{StaticResource Caption}" Margin="0,10,0,5"/>
                <TextBlock Text="任务在服务器执行，关闭客户端不会中断采集；创建后需单独点击“启动”。" Style="{StaticResource Caption}"/>
              </StackPanel></Border>
              <Expander x:Name="CrawlTaskFormExpander" Header="创建采集任务" IsExpanded="True" Margin="0,0,0,14"><Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock TextWrapping="Wrap" Text="采集方式" Margin="0,0,0,6"/><ComboBox x:Name="CrawlMode" SelectedIndex="0"><ComboBoxItem Content="限量采集 · 达到数量即结束" Tag="BOUNDED"/><ComboBoxItem Content="窗口增量 · 完整扫描后推进水位" Tag="INCREMENTAL"/></ComboBox></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="最多接收条数（1–10,000）" Margin="0,0,0,6"/><TextBox x:Name="CrawlMaxRecords" Text="100" MaxLength="5"/></StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock TextWrapping="Wrap" Text="单篇 DOI（填写后不再同时使用 ISSN / 关键词）" Margin="0,0,0,6"/><TextBox x:Name="CrawlDoi" MaxLength="300" ToolTip="例如 10.xxxx/xxxxx"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="期刊 ISSN（可选，至少提供 ISSN 或关键词）" Margin="0,0,0,6"/><TextBox x:Name="CrawlIssn" MaxLength="9" ToolTip="例如 1234-567X"/></StackPanel>
                </Grid>
                <TextBlock TextWrapping="Wrap" Text="检索关键词（可与 ISSN 联合限制范围）" Margin="0,12,0,6"/><TextBox x:Name="CrawlQuery" MaxLength="200"/>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock TextWrapping="Wrap" Text="来源更新时间 · 开始（UTC 日期）" Margin="0,0,0,6"/><DatePicker x:Name="CrawlFromDate" SelectedDateFormat="Short"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="来源更新时间 · 截止（最多 31 天）" Margin="0,0,0,6"/><DatePicker x:Name="CrawlUntilDate" SelectedDateFormat="Short"/></StackPanel>
                </Grid>
                <TextBlock Text="这是来源记录的更新时间窗口；成果发表年份可在高级条件中另行限定。单篇 DOI 不使用窗口推进水位。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                <Expander Header="高级条件与请求预算" Margin="0,14,0,0"><StackPanel Margin="0,10,0,0">
                  <UniformGrid Columns="4"><StackPanel Margin="0,0,12,0"><TextBlock TextWrapping="Wrap" Text="发表起始年（可选）" Margin="0,0,0,6"/><TextBox x:Name="CrawlPublicationFrom" MaxLength="4"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock TextWrapping="Wrap" Text="发表截止年（可选）" Margin="0,0,0,6"/><TextBox x:Name="CrawlPublicationTo" MaxLength="4"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock TextWrapping="Wrap" Text="每页条数（1–100）" Margin="0,0,0,6"/><TextBox x:Name="CrawlPageSize" Text="20" MaxLength="3"/></StackPanel><StackPanel><TextBlock TextWrapping="Wrap" Text="页预算（1–100）" Margin="0,0,0,6"/><TextBox x:Name="CrawlMaxPages" Text="10" MaxLength="3"/></StackPanel></UniformGrid>
                  <TextBlock Text="窗口增量必须扫描完整窗口才会推进水位；数量或页预算不足时请缩小范围，再创建关联任务。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                </StackPanel></Expander>
                <DockPanel Margin="0,16,0,0"><Button x:Name="CrawlCreateButton" DockPanel.Dock="Right" Content="创建任务" Click="CreateCrawlTask" Margin="12,0,0,0"/><TextBlock x:Name="CrawlParentInfo" Text="新任务 · 创建后等待启动" Style="{StaticResource Caption}"/></DockPanel>
              </StackPanel></Border></Expander>
              <StackPanel Margin="0,4,0,10"><TextBlock TextWrapping="Wrap" Text="采集任务" FontSize="18" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,0"><Button x:Name="CrawlStart" Content="启动" Tag="START" Click="CrawlAction" IsEnabled="False"/><Button x:Name="CrawlStop" Content="请求停止" Tag="STOP" Click="CrawlAction" Style="{StaticResource Secondary}" IsEnabled="False"/><Button x:Name="CrawlRetry" Content="重试" Tag="RETRY" Click="CrawlAction" Style="{StaticResource Secondary}" IsEnabled="False"/><Button x:Name="CrawlFollowup" Content="按此范围新建" Click="CrawlCreateFollowup" Style="{StaticResource Secondary}" IsEnabled="False"/><Button x:Name="CrawlOpenCatalog" Content="查看已收录成果" Click="ShowCrawlCatalog" Style="{StaticResource Secondary}" IsEnabled="False"/></WrapPanel></StackPanel>
              <DataGrid x:Name="CrawlTasks" Height="250" SelectionChanged="CrawlTaskSelected"><DataGrid.Columns>
                <DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="110"/><DataGridTextColumn Header="范围" Binding="{Binding ScopeLabel}" Width="240"/><DataGridTextColumn Header="方式" Binding="{Binding ModeLabel}" Width="95"/>
                <DataGridTextColumn Header="接收" Binding="{Binding Received}" Width="65"/><DataGridTextColumn Header="新增" Binding="{Binding Inserted}" Width="65"/><DataGridTextColumn Header="更新" Binding="{Binding Updated}" Width="65"/><DataGridTextColumn Header="未变" Binding="{Binding Unchanged}" Width="65"/><DataGridTextColumn Header="冲突" Binding="{Binding Conflicts}" Width="65"/><DataGridTextColumn Header="隔离" Binding="{Binding Excluded}" Width="65"/><DataGridTextColumn Header="已提交页" Binding="{Binding Pages}" Width="80"/>
              </DataGrid.Columns></DataGrid>
              <DockPanel Margin="0,10,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CrawlPrevious" Content="上一页" Tag="-1" Click="CrawlPageChanged" Style="{StaticResource Secondary}"/><Button x:Name="CrawlNext" Content="下一页" Tag="1" Click="CrawlPageChanged" Style="{StaticResource Secondary}" Margin="0"/></StackPanel><TextBlock x:Name="CrawlPageInfo" Style="{StaticResource Caption}"/></DockPanel>
              <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock TextWrapping="Wrap" Text="任务详情与执行记录" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CrawlTaskSummary" Text="选择任务查看状态、错误和断点。" TextWrapping="Wrap" Margin="0,10,0,8"/><TextBox x:Name="CrawlTaskLogs" IsReadOnly="True" Height="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="查看原始页" Click="ViewCrawlRawPage" Style="{StaticResource Secondary}" Margin="8,0,0,0"/><ComboBox x:Name="CrawlRawPages" DisplayMemberPath="Label" ToolTip="已提交页面及原始响应校验值"/></DockPanel>
                <TextBox x:Name="CrawlRawPreview" Visibility="Collapsed" IsReadOnly="True" Height="220" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock TextWrapping="Wrap" Text="成功增量水位" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CrawlCheckpointSummary" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
              <Expander x:Name="CrawlSettingsExpander" Header="来源启停、访问频率与服务器定时计划" Margin="0,0,0,14"><Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0"><StackPanel>
                <WrapPanel><CheckBox x:Name="CrawlSourceEnabled" Content="启用 Crossref 来源" Margin="0,0,24,0"/><CheckBox x:Name="CrawlScheduleEnabled" Content="启用服务器定时采集"/></WrapPanel>
                <UniformGrid Columns="3" Margin="0,14,0,0"><StackPanel Margin="0,0,12,0"><TextBlock TextWrapping="Wrap" Text="请求间隔（毫秒，≥ 1000）" Margin="0,0,0,6"/><TextBox x:Name="CrawlMinInterval" Text="1000" MaxLength="5"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock TextWrapping="Wrap" Text="计划间隔（分钟，≥ 60）" Margin="0,0,0,6"/><TextBox x:Name="CrawlScheduleEvery" Text="1440" MaxLength="5"/></StackPanel><StackPanel><TextBlock TextWrapping="Wrap" Text="计划期刊 ISSN" Margin="0,0,0,6"/><TextBox x:Name="CrawlScheduleIssn" MaxLength="9"/></StackPanel></UniformGrid>
                <UniformGrid Columns="3" Margin="0,14,0,0"><StackPanel Margin="0,0,12,0"><TextBlock TextWrapping="Wrap" Text="计划每页条数（1–100）" Margin="0,0,0,6"/><TextBox x:Name="CrawlSchedulePageSize" Text="50" MaxLength="3"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock TextWrapping="Wrap" Text="计划页预算（1–100）" Margin="0,0,0,6"/><TextBox x:Name="CrawlScheduleMaxPages" Text="20" MaxLength="3"/></StackPanel><StackPanel><TextBlock TextWrapping="Wrap" Text="初次回溯天数（1–31）" Margin="0,0,0,6"/><TextBox x:Name="CrawlScheduleLookback" Text="1" MaxLength="2"/></StackPanel></UniformGrid>
                <TextBlock x:Name="CrawlScheduleSummary" Style="{StaticResource Caption}" Margin="0,12,0,0"/><WrapPanel Margin="0,16,0,0"><Button x:Name="CrawlSaveSettingsButton" Content="保存来源与计划设置" Click="SaveCrawlSettings"/><Button x:Name="CrawlReloadSettingsButton" Content="重新读取设置" Click="ReloadCrawlSettings" Style="{StaticResource Secondary}"/></WrapPanel>
              </StackPanel></Border></Expander>
              <Expander Header="高级 / 兼容工具"><StackPanel Margin="0,10,0,0"><TextBlock Text="JSON 批次用于已有样本兼容、模拟资料及经整理的非论文数据。真实论文采集请使用上方来源任务。" Style="{StaticResource Caption}" Margin="0,0,0,10"/><Button Content="导入 JSON 批次" Click="ImportFile" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/></StackPanel></Expander>
            </StackPanel></ScrollViewer></TabItem>
<TabItem Header="成果目录"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="140"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AdminSearch" ToolTip="检索题名、摘要、DOI"/><ComboBox x:Name="AdminType" Grid.Column="1" SelectedIndex="0" Margin="8,0"><ComboBoxItem Content="全部类型" Tag=""/><ComboBoxItem Content="论文" Tag="PAPER"/><ComboBoxItem Content="授权专利" Tag="PATENT"/><ComboBoxItem Content="科研项目" Tag="PROJECT"/><ComboBoxItem Content="获奖" Tag="AWARD"/></ComboBox><Button Grid.Column="2" Content="检索目录" Click="AdminSearchClick"/></Grid>
            <DataGrid x:Name="AdminWorks" Grid.Row="1" SelectionChanged="AdminWorkSelected"><DataGrid.Columns><DataGridTextColumn Header="成果名称" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="100"/><DataGridTextColumn Header="日期" Binding="{Binding DateLabel}" Width="110"/><DataGridTextColumn Header="规范 ID" Binding="{Binding Id}" Width="150"/></DataGrid.Columns></DataGrid>
            <DockPanel Grid.Row="2" Margin="0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="AdminPrevious" Content="上一页" Click="AdminPage" Tag="-1" Style="{StaticResource Secondary}"/><Button x:Name="AdminNext" Content="下一页" Click="AdminPage" Tag="1" Style="{StaticResource Secondary}"/></StackPanel><TextBlock x:Name="AdminCatalogInfo" Style="{StaticResource Caption}"/></DockPanel>
            <TextBox Grid.Row="3" x:Name="AdminWorkDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="选择成果查看规范字段与原始来源。"/>
          </Grid></TabItem><TabItem Header="导入记录"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="刷新记录" Click="RefreshAdmin" Style="{StaticResource Secondary}"/><TextBlock Text="原始采集页与高级 JSON 工具的入库批次均保留记录。" Style="{StaticResource Caption}"/></DockPanel><DataGrid Grid.Row="1" x:Name="ImportsGrid"><DataGrid.Columns><DataGridTextColumn Header="来源" Binding="{Binding SourceName}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="接收" Binding="{Binding Received}" Width="75"/><DataGridTextColumn Header="新增" Binding="{Binding Inserted}" Width="75"/><DataGridTextColumn Header="更新" Binding="{Binding Updated}" Width="65"/><DataGridTextColumn Header="未变" Binding="{Binding Unchanged}" Width="65"/><DataGridTextColumn Header="冲突" Binding="{Binding Conflicts}" Width="65"/><DataGridTextColumn Header="发布版本" Binding="{Binding Revision}" Width="90"/></DataGrid.Columns></DataGrid></Grid></TabItem>
            <TabItem Header="数据质量"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="刷新质量信息" Click="RefreshQuality" Style="{StaticResource Secondary}" Margin="12,0,0,0"/><TextBlock x:Name="QualitySummary" Style="{StaticResource Caption}"/></DockPanel>
              <DataGrid Grid.Row="1" x:Name="QualityConflicts" SelectionChanged="QualityConflictSelected"><DataGrid.Columns><DataGridTextColumn Header="规范成果" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="来源" Binding="{Binding SourceName}" Width="110"/><DataGridTextColumn Header="复核原因" Binding="{Binding ReasonLabel}" Width="175"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="80"/></DataGrid.Columns></DataGrid>
              <DockPanel Grid.Row="2" Margin="0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="QualityPrevious" Content="上一页" Tag="-1" Click="QualityPageChanged" Style="{StaticResource Secondary}"/><Button x:Name="QualityNext" Content="下一页" Tag="1" Click="QualityPageChanged" Style="{StaticResource Secondary}" Margin="0"/></StackPanel><TextBlock x:Name="QualityPageInfo" Style="{StaticResource Caption}"/></DockPanel>
              <TextBox Grid.Row="3" x:Name="QualityDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="选择冲突查看来源与版本。本页只读，冲突资料不会覆盖当前公开成果。"/>
            </Grid></TabItem>
          </TabControl>
        </Grid></TabItem>
        <!-- 8: administrator application queue -->
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MinHeight="650"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="刷新队列" Click="RefreshAdmin"/><TextBlock Text="领取后审核，避免多人重复处理；每次结论都需填写依据。" Style="{StaticResource Caption}"/></DockPanel>
          <DataGrid x:Name="ReviewGrid" Grid.Row="1" SelectionChanged="ReviewSelected"><DataGrid.Columns><DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName}" Width="100"/><DataGridTextColumn Header="申请类型" Binding="{Binding KindLabel}" Width="135"/><DataGridTextColumn Header="目标" Binding="{Binding TargetLabel}" Width="*"/><DataGridTextColumn Header="阶段 / 操作" Binding="{Binding StageLabel}" Width="110"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="115"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="55"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="ReviewPrevious" Content="上一页" Click="ReviewPage" Tag="-1" Style="{StaticResource Secondary}"/><TextBlock x:Name="ReviewPageInfo" Margin="8,0,16,0"/><Button x:Name="ReviewNext" Content="下一页" Click="ReviewPage" Tag="1" Style="{StaticResource Secondary}"/></StackPanel>
          <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"><StackPanel><TextBlock Text="申请材料与处理历史" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="ReviewEvidence" IsReadOnly="True" Height="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="审核意见（通过、驳回与待补充时必填）" Style="{StaticResource Caption}" Margin="0,10,0,6"/><TextBox x:Name="ReviewReason" Height="48" MaxLength="2000" TextWrapping="Wrap"/><WrapPanel Margin="0,12,0,0"><Button Content="领取审核" Tag="TAKE" Click="ReviewAction"/><Button Content="通过" Tag="APPROVE" Click="ReviewAction"/><Button Content="待补充" Tag="NEED_MORE_INFO" Click="ReviewAction" Style="{StaticResource Secondary}"/><Button Content="驳回" Tag="REJECT" Click="ReviewAction" Style="{StaticResource Secondary}"/><Button Content="释放占用" Tag="RELEASE" Click="ReviewAction" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
        </Grid></ScrollViewer></TabItem>
        <!-- 9: administrator statistics -->
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="刷新统计" Click="AdminStatsClick"/><TextBlock x:Name="AdminStatsContext" Style="{StaticResource Caption}"/></DockPanel><UniformGrid x:Name="AdminMetricCards" Columns="3" Margin="0,0,-12,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="成果类型分布" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="AdminTypeChart"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="申请状态分布" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="AdminStateChart"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></TabItem>
      </TabControl>
      <DockPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="#748993"/><TextBlock x:Name="ScopeFooter" Text="课程模拟资料 · 不用于科研评价" FontSize="11" Foreground="#748993" HorizontalAlignment="Right"/></DockPanel>
    </Grid>
    <!-- Overlay covers the existing page; drag its left edge to resize. -->
    <Grid x:Name="CertificationOverlay" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="CertificationWidth" Width="340" MinWidth="300"/></Grid.ColumnDefinitions>
      <Border Background="#660F2733" MouseLeftButtonDown="DismissCertification"/>
      <GridSplitter Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="7" Background="#B9D6D0" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" ShowsPreview="False" Cursor="SizeWE" AutomationProperties.Name="调整认证面板宽度"/>
      <Border Grid.Column="1" Background="White" Padding="24,22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20"><Button x:Name="CloseCertificationButton" DockPanel.Dock="Right" Content="关闭" Click="CloseCertification" Style="{StaticResource Secondary}" Padding="12,7" Margin="10,0,0,0"/><TextBlock Text="学术门户认证" FontSize="20" FontWeight="SemiBold"/></DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CertificationForm">
          <Border Background="#EFF8F5" CornerRadius="8" Padding="14"><TextBlock x:Name="CertificationStage" TextWrapping="Wrap" Foreground="#2E6C62"/></Border>
          <TextBlock Text="认证机构" FontWeight="SemiBold" Margin="0,22,0,8"/><ComboBox x:Name="CertificationInstitution" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CertificationInstitutionChanged"/>
          <StackPanel x:Name="PortalChoice" Margin="0,16,0,0"><TextBlock Text="学者门户" FontWeight="SemiBold" Margin="0,0,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="查找" Click="FindCertificationScholars" Style="{StaticResource Secondary}" Margin="6,0,0,0" Padding="10,7"/><TextBox x:Name="CertificationScholarSearch" ToolTip="姓名或独立学者 ID"/></DockPanel><ComboBox x:Name="CertificationScholar" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,8,0,0"/><TextBlock Text="核对姓名、机构与独立标识，避免同名误认。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
          <TextBlock Text="申请说明与核验材料" FontWeight="SemiBold" Margin="0,22,0,8"/>
          <Grid><TextBox x:Name="CertificationEvidence" Height="210" MaxLength="7000" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="请说明真实姓名、所在机构 / 院系、职务或学籍信息，并提供机构主页、公开学者页面等可核验链接；请勿填写密码或证件完整号码。" Margin="12" Foreground="#8D9DA5" TextWrapping="Wrap" VerticalAlignment="Top" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CertificationEvidence}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid>
          <TextBlock Text="申请将发送给管理员。材料仅本人和审核人员可见，可在“我的申请”跟踪进度。" Style="{StaticResource Caption}" Margin="0,12,0,18"/>
          <TextBlock x:Name="CertificationError" Foreground="#A54B35" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Button x:Name="CertificationSubmit" Content="发送认证申请" Click="SubmitCertification" Margin="0"/>
        </StackPanel></ScrollViewer>
      </Grid></Border>
    </Grid>
  </Grid>
</Window>

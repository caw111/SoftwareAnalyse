<Window x:Class="AcademicDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="知汇 · 学术成果工作台" Icon="Assets/zhihui.ico" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" AllowsTransparency="False" Width="1200" Height="700" MinWidth="960" MinHeight="560" FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F3F6F8" Foreground="#172D3A" WindowStartupLocation="Manual" Loaded="WindowLoaded">
  <Grid Background="#F3F6F8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#142F3A"><DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="26,28,20,26"><StackPanel Orientation="Horizontal"><Image Source="Assets/zhihui.png" Width="40" Height="40" Margin="-4,0,9,0"/><TextBlock Text="知 汇" FontSize="28" FontWeight="Bold" Foreground="White"/></StackPanel><TextBlock Text="ACADEMIC WORKSPACE" FontSize="10" Foreground="#8CA9B6" Margin="0,7,0,0"/><Border Height="3" Width="30" Background="#48B8AB" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="25,20"><TextBlock Text="GROUP 02   /   DESKTOP" FontSize="10" Foreground="#88A7B3"/><TextBlock Text="Windows 原生客户端 · v0.1" FontSize="11" Foreground="#88A7B3" Margin="0,8,0,0"/><TextBlock x:Name="SidebarUser" Text="访客模式" Foreground="#D3E0E6" Margin="0,20,0,4" TextWrapping="Wrap"/><TextBlock Text="资料与证据，各有归处。" FontSize="11" Foreground="#88A7B3"/></StackPanel>
      <StackPanel x:Name="Navigation">
        <TextBlock Text="探索 / EXPLORE" Foreground="#6F929F" FontSize="10" Margin="28,0,0,12"/>
        <Button x:Name="NavDiscover" Content="◈    成果发现" Tag="0" Style="{StaticResource Nav}" Click="Navigate"/>
        <Button Content="◎    学者门户" Tag="1" Style="{StaticResource Nav}" Click="Navigate"/>
        <Button Content="▥    数据观察" Tag="2" Style="{StaticResource Nav}" Click="Navigate"/>
        <Button Content="◇    共著路径" Tag="3" Style="{StaticResource Nav}" Click="Navigate"/>
        <TextBlock Text="工作 / WORKSPACE" Foreground="#6F929F" FontSize="10" Margin="28,32,0,12"/>
        <Button Content="▤    我的工作台" Tag="4" Style="{StaticResource Nav}" Click="Navigate"/>
        <Button Content="⚙    管理与审核" Tag="5" Style="{StaticResource Nav}" Click="Navigate"/>
      </StackPanel>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="28,18,28,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="ServerAddress" Width="220" Text="http://127.0.0.1:8080" ToolTip="服务器 API 地址（远程连接必须使用 HTTPS）"/><Button Content="连接" Style="{StaticResource Secondary}" Click="Connect" Margin="8,0,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Fill="#9EB0B8" Width="7" Height="7" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionText" Text="等待连接" Style="{StaticResource Caption}"/><TextBlock Text="  /  学术成果检索与分享平台" Style="{StaticResource Caption}"/></StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="成果发现" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="从一项成果出发，发现知识与人的连接。" Foreground="#687F89" Margin="0,8,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="数据范围" Margin="0,0,10,0" Foreground="#687F89"/><ComboBox x:Name="Dataset" Width="160" SelectedIndex="0" SelectionChanged="DatasetChanged"><ComboBoxItem Content="课程模拟资料" Tag="demo"/><ComboBoxItem Content="真实资料" Tag="real"/></ComboBox></StackPanel>
      </Grid>
      <Border x:Name="Banner" Grid.Row="2" Background="#FFF2D9" CornerRadius="6" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="#80591B"/></Border>
      <TabControl x:Name="Pages" Grid.Row="3" SelectedIndex="0" BorderThickness="0" Background="Transparent">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid><TextBox x:Name="SearchText" AutomationProperties.Name="成果关键词" ToolTip="题名、摘要、DOI 或编号；空格分隔条件采用 AND" KeyDown="SearchKey"/><TextBlock Text="输入题名、摘要关键词、DOI 或编号…" Foreground="#8A9CA4" Margin="11,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                  <ComboBox x:Name="WorkType" Grid.Column="1" Margin="8,0" SelectedIndex="0"><ComboBoxItem Content="全部类型" Tag=""/><ComboBoxItem Content="论文" Tag="PAPER"/><ComboBoxItem Content="授权专利" Tag="PATENT"/><ComboBoxItem Content="科研项目" Tag="PROJECT"/><ComboBoxItem Content="获奖" Tag="AWARD"/></ComboBox>
                  <ComboBox x:Name="Sort" Grid.Column="2" SelectedIndex="0"><ComboBoxItem Content="年份优先" Tag="year"/><ComboBoxItem Content="引用优先" Tag="citations"/><ComboBoxItem Content="题名字序" Tag="title"/></ComboBox>
                  <Button x:Name="SearchButton" Grid.Column="3" Content="检索成果" Click="SearchClick" Margin="10,0,0,0" Padding="22,10"/>
                </Grid>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/><ColumnDefinition Width="20"/><ColumnDefinition Width="74"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="InstitutionFilter" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,8,0" ToolTip="成果发生时的机构"/>
                  <ComboBox x:Name="ScholarFilter" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,0,8,0" ToolTip="按独立人物 ID 筛选"/>
                  <ComboBox x:Name="FieldFilter" Grid.Column="2" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,8,0"/>
                  <TextBox x:Name="YearFrom" Grid.Column="3" ToolTip="起始年"/><TextBlock Grid.Column="4" Text="—" HorizontalAlignment="Center"/><TextBox x:Name="YearTo" Grid.Column="5" ToolTip="截止年"/>
                  <Button Grid.Column="6" Content="重置" Click="ResetSearch" Style="{StaticResource Secondary}" Margin="8,0,0,0"/>
                </Grid>
              </StackPanel>
            </Border>
            <DockPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock x:Name="ResultSummary" Text="连接服务后开始探索" FontWeight="SemiBold"/><TextBlock x:Name="ReleaseText" Text="" Foreground="#71858D" HorizontalAlignment="Right"/></DockPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
              <ListBox x:Name="WorkList" Background="Transparent" BorderThickness="0" SelectionChanged="WorkSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="White" BorderBrush="#E0E8EC" BorderThickness="1" CornerRadius="9" Padding="16"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#087F78"/><Setter TargetName="ItemBorder" Property="Background" Value="#F0FAF8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#70B9AE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><StackPanel><StackPanel Orientation="Horizontal"><Border Background="#E9F3F3" CornerRadius="3" Padding="7,3"><TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="#24776F"/></Border><TextBlock Text="{Binding DateLabel}" Margin="10,0,0,0" FontSize="11" Foreground="#70858D"/></StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,7"/><TextBlock Text="{Binding People}" Foreground="#4D6874" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Footer}" FontSize="11" Foreground="#84959D" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DetailPanel"><TextBlock Text="成果详情" Style="{StaticResource SectionTitle}"/><TextBlock Text="选中一项成果，查看题录、贡献角色、类型字段与来源。" Style="{StaticResource Caption}"/></StackPanel></ScrollViewer></Border>
            </Grid>
            <DockPanel Grid.Row="3" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一页" x:Name="PreviousPage" Click="Previous" Style="{StaticResource Secondary}"/><TextBlock x:Name="PageNumber" Text="1" Margin="8,0,16,0"/><Button Content="下一页" x:Name="NextPage" Click="Next" Style="{StaticResource Secondary}" Margin="0"/></StackPanel><TextBlock Text="模拟资料仅用于课程演示；引用缺失与零值分别显示。" Style="{StaticResource Caption}"/></DockPanel>
          </Grid>
        </TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="查找学者" Click="LoadScholarsClick" Margin="12,0,0,0"/><TextBox x:Name="ScholarSearch" ToolTip="姓名或学者 ID"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><DataGrid x:Name="ScholarsGrid" SelectionChanged="ScholarSelected"><DataGrid.Columns><DataGridTextColumn Header="学者" Binding="{Binding Name}" Width="100"/><DataGridTextColumn Header="独立标识" Binding="{Binding Id}" Width="90"/><DataGridTextColumn Header="当前机构" Binding="{Binding InstitutionName}" Width="*"/><DataGridTextColumn Header="门户" Binding="{Binding ClaimLabel}" Width="80"/></DataGrid.Columns></DataGrid><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="ScholarName" Text="独立人物，准确关联" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ScholarBio" Text="同名人物以独立标识区分。门户管理权与成果贡献分别审核。" Style="{StaticResource Caption}" Margin="0,8,0,20"/><Button Content="查看此人的成果" Click="ScholarWorks" Margin="0,0,0,12"/><TextBlock Text="认领依据（私有）" Margin="0,0,0,8"/><TextBox x:Name="PortalEvidence" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Content="申请管理此门户" Click="ClaimPortal" Margin="0,12,0,0"/></StackPanel></Border></Grid></Grid></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="刷新统计" Click="StatsClick" Margin="0"/><TextBlock x:Name="StatsContext" Text="全库分类统计 · 同版目录" Style="{StaticResource Caption}"/></DockPanel><UniformGrid Columns="4" x:Name="MetricCards" Margin="0,0,-12,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="成果类型" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="TypeChart"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="年度分布" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="YearChart"/></StackPanel></Border></Grid><Grid Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="机构成果数量" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="InstitutionChart"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="领域分布" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="FieldChart"/></StackPanel></Border></Grid><TextBlock x:Name="StatisticsNotes" Style="{StaticResource Caption}"/></StackPanel></ScrollViewer></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="寻找两位学者间的共著联系" Style="{StaticResource SectionTitle}"/><TextBlock Text="仅使用已识别人物及论文署名关系。路径上的每条连接都有论文证据。" Style="{StaticResource Caption}" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="GraphStart" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center"/><ComboBox Grid.Column="2" x:Name="GraphEnd" DisplayMemberPath="Label" SelectedValuePath="Id"/><Button Grid.Column="3" Content="寻找最短路径" Click="FindPath" Margin="12,0,0,0"/></Grid></StackPanel></Border><TextBlock x:Name="GraphMessage" Grid.Row="1" Text="最多六跳；只反映当前数据集，不能解释为全部学术合作。" Margin="0,16" Style="{StaticResource Caption}"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><WrapPanel x:Name="GraphPath" Margin="0,0,0,20"/><StackPanel x:Name="GraphEvidence"/></StackPanel></ScrollViewer></Grid></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><StackPanel><DockPanel><TextBlock Text="账号与身份" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="AccountInfo" HorizontalAlignment="Right" Foreground="#087F78"/></DockPanel><WrapPanel><TextBox x:Name="Username" Width="160" Text="researcher" ToolTip="账号"/><PasswordBox x:Name="Password" Width="180" Margin="8,0" ToolTip="密码"/><Button Content="登录" Click="Login"/><Button Content="注册账号" Style="{StaticResource Secondary}" Click="Register"/><Button Content="退出" Style="{StaticResource Secondary}" Click="Logout"/></WrapPanel><TextBlock Text="本地演示账号：admin / researcher / reader　密码：DemoPass2026!（生产模式不创建这些演示账号）" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
          <DockPanel Grid.Row="1" Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="申请科研身份" Click="IdentityClaim" Style="{StaticResource Secondary}"/><Button Content="刷新工作台" Click="RefreshMine" Margin="0"/></StackPanel><TextBlock Text="我的申请与成果" Style="{StaticResource SectionTitle}"/></DockPanel>
          <TabControl Grid.Row="2"><TabItem Header="申请进度"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="MyClaims" SelectionChanged="MyClaimSelected"><DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding KindLabel}" Width="110"/><DataGridTextColumn Header="目标" Binding="{Binding TargetLabel}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="130"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="60"/></DataGrid.Columns></DataGrid><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"><StackPanel><TextBlock x:Name="MyClaimReason" Text="选择申请以查看意见。补充材料仅本人和审核员可见。" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="SupplementEvidence" Height="66" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="提交草稿 / 补充重提" Tag="SUBMIT" Click="MineAction"/><Button Content="撤回申请" Tag="WITHDRAW" Click="MineAction" Style="{StaticResource Secondary}"/></StackPanel></StackPanel></Border></Grid></TabItem><TabItem Header="已确认成果"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="MyWorks"><DataGrid.Columns><DataGridTextColumn Header="成果" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="110"/><DataGridTextColumn Header="年份" Binding="{Binding DateLabel}" Width="80"/></DataGrid.Columns></DataGrid><Button Grid.Row="1" Content="申请撤销本人关联" Click="RevokeOutcome" HorizontalAlignment="Right" Margin="0,12,0,0"/></Grid></TabItem></TabControl>
        </Grid></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="导入 JSON 批次" Click="ImportFile" Style="{StaticResource Secondary}"/><Button Content="刷新管理台" Click="RefreshAdmin" Margin="0"/></StackPanel><TextBlock Text="人工审核 · 来源入库" Style="{StaticResource SectionTitle}"/></DockPanel><TabControl Grid.Row="1"><TabItem Header="审核队列"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="ReviewGrid" SelectionChanged="ReviewSelected"><DataGrid.Columns><DataGridTextColumn Header="申请人" Binding="{Binding ApplicantName}" Width="120"/><DataGridTextColumn Header="类别" Binding="{Binding KindLabel}" Width="90"/><DataGridTextColumn Header="目标" Binding="{Binding TargetLabel}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="125"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="50"/></DataGrid.Columns></DataGrid><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"><StackPanel><TextBlock Text="私有证明与处理历史" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="ReviewEvidence" IsReadOnly="True" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBox x:Name="ReviewReason" Height="48" ToolTip="审核依据 / 待补充项（必填）" Margin="0,8"/><WrapPanel><Button Content="领取审核" Tag="TAKE" Click="ReviewAction"/><Button Content="通过" Tag="APPROVE" Click="ReviewAction"/><Button Content="待补充" Tag="NEED_MORE_INFO" Click="ReviewAction" Style="{StaticResource Secondary}"/><Button Content="驳回" Tag="REJECT" Click="ReviewAction" Style="{StaticResource Secondary}"/><Button Content="释放占用" Tag="RELEASE" Click="ReviewAction" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border></Grid></TabItem><TabItem Header="导入记录"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="受控结构化导入，每批最多 200 条。重复幂等键不会重复入库；失败的批次整体回滚。真实来源的联网采集尚未启用。" Style="{StaticResource Caption}" Margin="0,0,0,12"/><DataGrid Grid.Row="1" x:Name="ImportsGrid"><DataGrid.Columns><DataGridTextColumn Header="来源" Binding="{Binding SourceName}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="接收" Binding="{Binding Received}" Width="75"/><DataGridTextColumn Header="新增" Binding="{Binding Inserted}" Width="75"/><DataGridTextColumn Header="重复" Binding="{Binding Duplicates}" Width="75"/><DataGridTextColumn Header="发布版本" Binding="{Binding Revision}" Width="90"/></DataGrid.Columns></DataGrid></Grid></TabItem></TabControl></Grid></TabItem>
      </TabControl>
      <DockPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="#748993"/><TextBlock x:Name="ScopeFooter" Text="课程模拟资料 · 不用于科研评价" FontSize="11" Foreground="#748993" HorizontalAlignment="Right"/></DockPanel>
    </Grid>
  </Grid>
</Window>

<Window x:Class="AcademicDesktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="知汇 · 登录" Icon="Assets/zhihui.ico"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" AllowsTransparency="False"
        Width="1200" Height="700" MinWidth="960" MinHeight="560" WindowStartupLocation="Manual"
        Background="#EEF4F4" Loaded="WindowLoaded">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#36535D"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,13,0,6"/>
    </Style>
    <Style x:Key="AuthTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="#6B8087"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Width" Value="174"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabSurface" Background="Transparent" Padding="12,13" BorderBrush="#DFE9E9" BorderThickness="0,0,0,2">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#087F78"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="#087F78"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#F0F8F6"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E4F3EF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MaxWidth="1080" Margin="36,32" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="452"/></Grid.ColumnDefinitions>
      <Border Background="#142F3A" CornerRadius="22,0,0,22" Padding="46,48,42,40">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal"><Image Source="Assets/zhihui.png" Width="58" Height="58" Margin="-6,0,10,0"/><TextBlock Text="知 汇" Foreground="White" FontSize="32" FontWeight="Bold"/></StackPanel>
            <TextBlock Text="ACADEMIC WORKSPACE" Foreground="#88AAA9" FontSize="10" Margin="0,14,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,42,0,42">
            <Border Width="38" Height="4" Background="#59C8B2" HorizontalAlignment="Left" Margin="0,0,0,24"/>
            <TextBlock Text="让研究被看见。" FontSize="32" FontWeight="SemiBold" Foreground="#F3FCF9" TextWrapping="Wrap"/>
            <TextBlock Text="从一项成果出发，连接学者与新的发现。" Foreground="#BDD3D8" FontSize="14" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,0"/>
            <StackPanel Margin="0,32,0,0">
              <TextBlock Text="01   探索论文、专利、项目与获奖" Foreground="#B8CED1" Margin="0,0,0,13"/>
              <TextBlock Text="02   建立属于你的学术主页" Foreground="#B8CED1" Margin="0,0,0,13"/>
              <TextBlock Text="03   让每一份成果都有据可循" Foreground="#B8CED1"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Grid.Row="2" Text="GROUP 02  /  知识因连接而生长" Foreground="#7FA4AD" FontSize="11"/>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="White" CornerRadius="0,22,22,0" Padding="48,36,48,26">
        <StackPanel>
          <TextBlock Text="欢迎来到知汇" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock Text="登录管理个人成果，或先以访客身份探索。" Style="{StaticResource Caption}" Margin="0,9,0,18"/>
          <StackPanel x:Name="FormPanel">
            <TabControl x:Name="AuthTabs" SelectedIndex="0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource AuthTab}" SelectionChanged="AuthTabChanged">
              <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,6,0,0"/></Grid>
                </ControlTemplate>
              </TabControl.Template>
              <TabItem Header="登录">
                <StackPanel>
                  <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="LoginUsername" MaxLength="80" AutomationProperties.Name="登录用户名"/>
                  <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="LoginPassword" MaxLength="128" AutomationProperties.Name="登录密码"/>
                  <Button x:Name="LoginButton" Content="登录" IsDefault="True" Click="LoginClicked" Margin="0,24,0,0" Padding="16,13"/>
                </StackPanel>
              </TabItem>
              <TabItem Header="注册">
                <StackPanel>
                  <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="RegisterUsername" MaxLength="40" AutomationProperties.Name="注册用户名"/>
                  <TextBlock Text="3–40 位字母、数字，支持 _ . -" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                  <TextBlock Text="姓名" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="RegisterDisplayName" MaxLength="100" AutomationProperties.Name="姓名"/>
                  <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="RegisterPassword" MaxLength="128" AutomationProperties.Name="注册密码"/>
                  <TextBlock Text="12–128 位字符" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                  <TextBlock Text="确认密码" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="RegisterConfirmation" MaxLength="128" AutomationProperties.Name="确认密码"/>
                  <TextBlock Text="注册后可提交门户认证申请，由管理员审核。" Style="{StaticResource Caption}" Margin="0,14,0,0"/>
                  <Button x:Name="RegisterButton" Content="创建账号" Click="RegisterClicked" Margin="0,18,0,0" Padding="16,13"/>
                </StackPanel>
              </TabItem>
            </TabControl>
            <Button x:Name="GuestButton" Content="以访客模式进入" Click="GuestClicked" FontSize="12" Foreground="#7A8B91" Background="Transparent" Margin="0,12,0,0" Padding="12,10"/>
            <Expander Header="服务器设置" FontSize="11" Foreground="#7A8B91" Margin="0,15,0,0">
              <StackPanel Margin="0,9,0,0"><TextBlock Text="API 地址" Style="{StaticResource Caption}" Margin="0,0,0,5"/><TextBox x:Name="ServerAddress" FontSize="12" MaxLength="2048" AutomationProperties.Name="服务器 API 地址"/><TextBlock Text="远程连接使用 HTTPS；本机支持 HTTP。" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
            </Expander>
          </StackPanel>
          <Border x:Name="MessagePanel" Background="#F0F6F5" CornerRadius="7" Padding="12" Margin="0,16,0,0" Visibility="Collapsed"><TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12" Foreground="#36535D"/></Border>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>

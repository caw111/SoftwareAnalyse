FROM eclipse-temurin:21-jre-alpine@sha256:ac05c3c42b7c2f1a52c9bd52f01041fa1958231b15ebeae7420429cbc5baf474
ARG REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/caw111/SoftwareAnalyse" \
      org.opencontainers.image.revision=$REVISION
RUN addgroup -S app && adduser -S -G app -u 10001 app
WORKDIR /app
COPY --chown=10001:10001 build/libs/academic-platform-api.jar app.jar
USER 10001:10001
ENV APP_DEMO=false SERVER_ADDRESS=0.0.0.0 MANAGEMENT_ADDRESS=0.0.0.0 \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65 -XX:InitialRAMPercentage=20 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8"
EXPOSE 8080 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]

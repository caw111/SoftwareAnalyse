        <mxCell id="c28" value="步骤 5 至 10 任一服务失败立即转步骤 13。成功分页、详情和统计明细沿用同一版本；版本清理明确报错，旧快照不能恢复撤销权限。" style="fontFamily=Microsoft YaHei;fontSize=22;whiteSpace=wrap;html=0;shape=note;size=18;fillColor=#fff9e8;strokeColor=#c6b27b;align=left;spacing=12;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="50" y="1695" width="2010" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="引用缺失不当作 0；未知年份置后；未分类不生成学科。空集合、超时、类型不适用和版本过期分别展示，外部采集故障不触发实时外网补查。" style="fontFamily=Microsoft YaHei;fontSize=22;whiteSpace=wrap;html=0;shape=note;size=18;fillColor=#fff9e8;strokeColor=#c6b27b;align=left;spacing=12;fontSize=21;" vertex="1" parent="1">

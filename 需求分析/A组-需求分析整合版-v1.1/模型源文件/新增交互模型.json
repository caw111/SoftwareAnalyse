[
  {
    "file": "05-门户认领审核时序图",
    "title": "门户认领审核 主交互",
    "sub": "图5-1  已审核科研身份是申请前提；审核材料仅向本人和有权审核人开放",
    "lanes": [
      "申请人\n«actor»",
      "有权审核人\n«actor»",
      "认领与审核页面\n«boundary»",
      "ClaimControl\n«control»",
      "Account／\nScholarPortal\n«entity group»",
      "ClaimApplication／\nReviewRecord\n«entity group»"
    ],
    "rows": [
      {
        "kind": "msg",
        "id": "CL01",
        "a": 0,
        "b": 2,
        "text": "申请人提交目标门户与证明材料",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "CL02",
        "a": 2,
        "b": 3,
        "text": "submitClaim(门户、材料版本、预期版本)",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "CL03",
        "a": 3,
        "b": 4,
        "text": "canApplyForPortal()；核对目标与有效绑定",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "CL04",
        "a": 4,
        "b": 3,
        "text": "返回资格、目标及占用检查结果",
        "ret": true
      },
      {
        "kind": "frame",
        "op": "break",
        "guard": "未登录／身份未通过／材料不合法／已有冲突绑定",
        "rows": [
          {
            "kind": "msg",
            "id": "CL05",
            "a": 3,
            "b": 2,
            "text": "返回具体原因；首次仍为 DRAFT，补交仍待补充",
            "ret": false
          }
        ]
      },
      {
        "kind": "msg",
        "id": "CL06",
        "a": 3,
        "b": 5,
        "text": "submit(expectedVersion)；有效提交至 PENDING_REVIEW",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "CL07",
        "a": 5,
        "b": 3,
        "text": "提交成功：申请编号、材料版本、对象版本",
        "ret": true
      },
      {
        "kind": "msg",
        "id": "CL08",
        "a": 3,
        "b": 2,
        "text": "显示待审核回执；未产生门户管理权",
        "ret": true
      },
      {
        "kind": "band",
        "text": "审核阶段  与首次提交分属不同用户请求"
      },
      {
        "kind": "msg",
        "id": "CL09",
        "a": 1,
        "b": 2,
        "text": "审核人打开申请并提交审核动作与理由",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "CL10",
        "a": 2,
        "b": 3,
        "text": "reviewClaim(申请、动作、理由、预期版本)",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "CL11",
        "a": 3,
        "b": 4,
        "text": "checkObjectPermission(申请)；核对审核范围",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "CL12",
        "a": 3,
        "b": 5,
        "text": "读取当前状态和有权访问的材料版本",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "break",
        "guard": "无审核权限或材料／对象版本已变化",
        "rows": [
          {
            "kind": "msg",
            "id": "CL13",
            "a": 3,
            "b": 2,
            "text": "拒绝本次操作并提示刷新；保留已提交状态",
            "ret": false
          }
        ]
      },
      {
        "kind": "frame",
        "op": "alt",
        "guard": "证据不足且状态为 PENDING_REVIEW",
        "rows": [
          {
            "kind": "msg",
            "id": "CL14",
            "a": 3,
            "b": 5,
            "text": "requestMore(reason, version)＋appendDecision()",
            "ret": false
          },
          {
            "kind": "else",
            "guard": "证据不成立且状态为 PENDING_REVIEW"
          },
          {
            "kind": "msg",
            "id": "CL15",
            "a": 3,
            "b": 5,
            "text": "reject(reason, version)＋appendDecision()",
            "ret": false
          },
          {
            "kind": "else",
            "guard": "拟批准且状态为 PENDING_REVIEW"
          },
          {
            "kind": "ref",
            "text": "图5-2 CX01—CX06  事务内重验并原子创建授权"
          }
        ]
      },
      {
        "kind": "msg",
        "id": "CL16",
        "a": 3,
        "b": 2,
        "text": "仅提交成功后返回实际结果；失败不通知通过",
        "ret": true
      },
      {
        "kind": "frame",
        "op": "opt",
        "guard": "申请人对 NEED_MORE_INFO 补交材料",
        "rows": [
          {
            "kind": "msg",
            "id": "CL17",
            "a": 0,
            "b": 2,
            "text": "补交形成新材料版本；沿用原申请编号",
            "ret": false
          },
          {
            "kind": "ref",
            "text": "重入 CL02—CL08  校验通过后 submit() 回 PENDING_REVIEW"
          }
        ]
      },
      {
        "kind": "ref",
        "text": "本人撤回与终审竞争见图5-2 CX07—CX10；终态再申请使用新编号"
      }
    ]
  },
  {
    "file": "05a-认领原子授权与撤回子交互",
    "title": "认领原子授权与撤回竞争",
    "sub": "图5-2  调用自图5-1批准分支；两条路径是独立并发请求，非先批准再撤回",
    "lanes": [
      "有权审核人\n«actor»",
      "申请人\n«actor»",
      "ClaimControl\n«control»",
      "ClaimApplication\n«entity»",
      "PortalAuthorization\n«entity»",
      "ReviewRecord／\nAuditEntry\n«entity / value»"
    ],
    "rows": [
      {
        "kind": "band",
        "text": "路径A  管理员批准请求"
      },
      {
        "kind": "msg",
        "id": "CX01",
        "a": 0,
        "b": 2,
        "text": "approveClaim(申请、材料版本、expectedVersion)",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "critical",
        "guard": "批准事务  账号资格、审核权限、目标版本与双方有效唯一性重验",
        "rows": [
          {
            "kind": "msg",
            "id": "CX02",
            "a": 2,
            "b": 3,
            "text": "重读申请；仅 PENDING_REVIEW 且版本匹配可继续",
            "ret": false
          },
          {
            "kind": "msg",
            "id": "CX03",
            "a": 2,
            "b": 4,
            "text": "复核有效授权：账号最多一个；门户最多一个",
            "ret": false
          },
          {
            "kind": "frame",
            "op": "alt",
            "guard": "全部条件成立",
            "rows": [
              {
                "kind": "msg",
                "id": "CX04",
                "a": 2,
                "b": 3,
                "text": "approve(expectedVersion) → APPROVED",
                "ret": false
              },
              {
                "kind": "msg",
                "id": "CX05",
                "a": 2,
                "b": 4,
                "text": "创建指定账号与门户的有效授权",
                "ret": false
              },
              {
                "kind": "msg",
                "id": "CX06",
                "a": 2,
                "b": 5,
                "text": "appendDecision(批准, 理由)；追加审计；共同提交",
                "ret": false
              },
              {
                "kind": "else",
                "guard": "状态／权限／唯一性冲突或任一步持久化失败"
              },
              {
                "kind": "band",
                "text": "整笔回滚或拒绝；读取实际已提交状态，不重置并发胜出的撤回"
              }
            ]
          }
        ]
      },
      {
        "kind": "band",
        "text": "路径B  本人撤回请求  可与路径A竞争同一申请版本"
      },
      {
        "kind": "msg",
        "id": "CX07",
        "a": 1,
        "b": 2,
        "text": "withdrawClaim(申请、expectedVersion)",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "critical",
        "guard": "撤回事务  校验本人身份、当前状态和预期版本",
        "rows": [
          {
            "kind": "frame",
            "op": "alt",
            "guard": "PENDING_REVIEW 或 NEED_MORE_INFO 且版本匹配",
            "rows": [
              {
                "kind": "msg",
                "id": "CX08",
                "a": 2,
                "b": 3,
                "text": "withdraw(expectedVersion) → WITHDRAWN",
                "ret": false
              },
              {
                "kind": "msg",
                "id": "CX09",
                "a": 2,
                "b": 5,
                "text": "追加撤回审计；共同提交，不创建授权",
                "ret": false
              },
              {
                "kind": "else",
                "guard": "审批已提交／版本过期／其他不允许状态"
              },
              {
                "kind": "band",
                "text": "拒绝撤回，返回实际终态；不能撤销已经生效的授权"
              }
            ]
          }
        ]
      },
      {
        "kind": "msg",
        "id": "CX10",
        "a": 2,
        "b": 1,
        "text": "返回提交结果／版本冲突；同一版本最多一条路径成功",
        "ret": true
      },
      {
        "kind": "ref",
        "text": "通过后解除授权使用 PortalAuthorization.revoke()；保留 APPROVED 和历史"
      }
    ]
  },
  {
    "file": "06-检索请求处理时序图",
    "title": "检索请求处理 主交互",
    "sub": "图6-1  匿名用户可查询公开成果；列表、分页、详情固定同一公开版本",
    "lanes": [
      "公众用户\n«actor»",
      "搜索与详情页面\n«boundary»",
      "SearchControl\n«control»",
      "PublicRelease／\nReleaseEntry\n«entity group»",
      "查询引擎／权限服务\n«control»"
    ],
    "rows": [
      {
        "kind": "msg",
        "id": "Q01",
        "a": 0,
        "b": 1,
        "text": "输入关键词、类型、人物、机构、时间与排序",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "opt",
        "guard": "输入同名人物且要求精确人物筛选",
        "rows": [
          {
            "kind": "ref",
            "text": "先显示人物候选及机构证据；用户确认 ScholarId 后继续"
          }
        ]
      },
      {
        "kind": "msg",
        "id": "Q02",
        "a": 1,
        "b": 2,
        "text": "search(条件、page_size、releaseId?、continuation?)",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "break",
        "guard": "参数非法／字段不适用／人物尚未确认",
        "rows": [
          {
            "kind": "msg",
            "id": "Q03",
            "a": 2,
            "b": 1,
            "text": "返回字段级原因并保留输入；不执行查询",
            "ret": false
          }
        ]
      },
      {
        "kind": "msg",
        "id": "Q04",
        "a": 2,
        "b": 3,
        "text": "首次固定可用 release；续页验证原 release 与查询令牌",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "break",
        "guard": "公开版本已失效或无可用公开版本",
        "rows": [
          {
            "kind": "msg",
            "id": "Q05",
            "a": 2,
            "b": 1,
            "text": "说明版本失效或服务不可用；不混入最新数据",
            "ret": false
          }
        ]
      },
      {
        "kind": "msg",
        "id": "Q06",
        "a": 3,
        "b": 2,
        "text": "返回 releaseId、分类版本、规则版本、数据范围",
        "ret": true
      },
      {
        "kind": "ref",
        "text": "图6-2 QX01—QX08（含QX04a）  同版检索＋实时权限过滤＋统一计数分页"
      },
      {
        "kind": "msg",
        "id": "Q07",
        "a": 2,
        "b": 1,
        "text": "返回可见列表、总量、分面、版本与查询令牌",
        "ret": true
      },
      {
        "kind": "frame",
        "op": "alt",
        "guard": "有效查询无命中",
        "rows": [
          {
            "kind": "msg",
            "id": "Q08",
            "a": 1,
            "b": 0,
            "text": "显示0条与当前条件；提供修改筛选入口",
            "ret": true
          },
          {
            "kind": "else",
            "guard": "有效查询有命中"
          },
          {
            "kind": "msg",
            "id": "Q09",
            "a": 1,
            "b": 0,
            "text": "按类型分组展示；保留来源、缺失值和状态",
            "ret": true
          }
        ]
      },
      {
        "kind": "band",
        "text": "同版详情  后续独立请求"
      },
      {
        "kind": "msg",
        "id": "Q10",
        "a": 0,
        "b": 1,
        "text": "打开结果详情",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "Q11",
        "a": 1,
        "b": 2,
        "text": "detail(规范成果ID、原 releaseId、查询上下文)",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "Q12",
        "a": 2,
        "b": 4,
        "text": "核对当前权限与指定公开版本可用性",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "break",
        "guard": "无权限／版本失效／读取失败",
        "rows": [
          {
            "kind": "msg",
            "id": "Q13",
            "a": 2,
            "b": 1,
            "text": "分别提示无权访问、重新检索或稍后重试",
            "ret": false
          }
        ]
      },
      {
        "kind": "msg",
        "id": "Q14",
        "a": 2,
        "b": 3,
        "text": "resolveEntry(workId)；readPublicView(permissionContext)",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "Q15",
        "a": 3,
        "b": 2,
        "text": "同版题录、贡献、来源、类型日期；不含私有证明",
        "ret": true
      },
      {
        "kind": "msg",
        "id": "Q15a",
        "a": 2,
        "b": 4,
        "text": "同版读取后重验当前权限及读取完整性",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "break",
        "guard": "权限变化／读取失败／同版不可满足",
        "rows": [
          {
            "kind": "band",
            "text": "执行Q13对应错误响应并结束；不返回详情，不回退最新版本"
          }
        ]
      },
      {
        "kind": "msg",
        "id": "Q16",
        "a": 2,
        "b": 1,
        "text": "返回详情与原查询上下文；返回列表恢复条件",
        "ret": true
      }
    ]
  },
  {
    "file": "06a-检索权限计数与分页子交互",
    "title": "检索权限计数与分页一致性",
    "sub": "图6-2  统一允许集合约束列表、总数与分面；权限变化不能通过旧快照恢复",
    "lanes": [
      "SearchControl\n«control»",
      "PermissionPolicy\n«control»",
      "SearchIndex\n«read model»",
      "PublicRelease／\nReleaseEntry\n«entity group»"
    ],
    "rows": [
      {
        "kind": "msg",
        "id": "QX01",
        "a": 0,
        "b": 1,
        "text": "获取当前公开可见约束与 permissionRevision",
        "ret": false
      },
      {
        "kind": "msg",
        "id": "QX02",
        "a": 1,
        "b": 0,
        "text": "返回同一可见范围表达式与权限修订号",
        "ret": true
      },
      {
        "kind": "frame",
        "op": "break",
        "guard": "续页令牌的权限修订已过期",
        "rows": [
          {
            "kind": "band",
            "text": "返回查询上下文冲突；保留条件，要求重新查询"
          }
        ]
      },
      {
        "kind": "msg",
        "id": "QX03",
        "a": 0,
        "b": 2,
        "text": "查询固定 release；同贡献筛选＋可见约束",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "critical",
        "guard": "一次逻辑查询使用同一候选集合与同版读视图",
        "rows": [
          {
            "kind": "band",
            "text": "先身份／类型／条件匹配 → 解析规范ID → 按实时可见范围过滤"
          },
          {
            "kind": "band",
            "text": "再计算总数与分面 → 稳定排序 → 分页；不可先分页再剔除"
          },
          {
            "kind": "msg",
            "id": "QX04",
            "a": 2,
            "b": 0,
            "text": "返回规范ID页、total、facets与读视图标记",
            "ret": true
          }
        ]
      },
      {
        "kind": "frame",
        "op": "break",
        "guard": "查询超时／索引失败／查询返回版本不一致",
        "rows": [
          {
            "kind": "band",
            "text": "立即返回查询或版本错误；不作页码判断，不把故障当0条"
          }
        ]
      },
      {
        "kind": "msg",
        "id": "QX04a",
        "a": 0,
        "b": 0,
        "text": "依据实际total校验页码；total=0仅page=1有效",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "break",
        "guard": "页码超出有效范围",
        "rows": [
          {
            "kind": "band",
            "text": "返回页码错误并保留条件；不读取详情，不伪装有效空集"
          }
        ]
      },
      {
        "kind": "frame",
        "op": "opt",
        "guard": "规范ID页非空",
        "rows": [
          {
            "kind": "msg",
            "id": "QX05",
            "a": 0,
            "b": 3,
            "text": "按同一release批量读公开条目和来源；核对完整性",
            "ret": false
          }
        ]
      },
      {
        "kind": "frame",
        "op": "break",
        "guard": "公开读取失败／同版条目缺失",
        "rows": [
          {
            "kind": "band",
            "text": "立即返回读取或一致性错误；不返回部分列表，不由权限变化覆盖故障"
          }
        ]
      },
      {
        "kind": "msg",
        "id": "QX06",
        "a": 0,
        "b": 1,
        "text": "返回前重验 permissionRevision 与页内对象权限",
        "ret": false
      },
      {
        "kind": "frame",
        "op": "alt",
        "guard": "权限修订未变化且所有数据同版",
        "rows": [
          {
            "kind": "msg",
            "id": "QX07",
            "a": 0,
            "b": 0,
            "text": "生成绑定条件、release、权限修订与排序位置的查询令牌",
            "ret": false
          },
          {
            "kind": "else",
            "guard": "权限已变化／原查询令牌权限修订过期"
          },
          {
            "kind": "band",
            "text": "本次结果作废；要求显式重试，不返回旧total／facets或部分列表"
          },
          {
            "kind": "else",
            "guard": "权限校验服务失败"
          },
          {
            "kind": "band",
            "text": "明确失败并保留条件；不返回旧计数或部分成功"
          }
        ]
      },
      {
        "kind": "msg",
        "id": "QX08",
        "a": 0,
        "b": 0,
        "text": "成功回主图Q07；失败直接返回可恢复原因",
        "ret": false
      },
      {
        "kind": "ref",
        "text": "内部一致性策略为本次设计决策；目标是列表 total facets 使用同一可见集合"
      },

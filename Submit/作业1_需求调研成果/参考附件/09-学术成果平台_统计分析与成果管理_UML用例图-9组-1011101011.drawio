        <mxCell id="edge-11" value="«include»" style="html=1;rounded=0;strokeColor=#5B6C7E;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#26364A;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;endSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="UC-AM-02" target="UC-AM-11">

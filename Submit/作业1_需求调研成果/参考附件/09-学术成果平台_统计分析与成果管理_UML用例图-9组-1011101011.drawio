        <mxCell id="scope-note" value="&lt;div style=&quot;font-size:19px;font-weight:bold;color:#24496B;margin-bottom:10px&quot;&gt;分析范围与口径&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;成果类型：论文、专利、项目、获奖。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;按年份、领域、机构及数据集筛选。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;共著网络以论文共同署名为依据。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;所有结果注明来源、覆盖率与快照时间。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;缺失值、模拟数据与多机构计数须说明。&lt;/div&gt;" style="fontFamily=Microsoft YaHei;fontColor=#26364A;shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#A7B4C1;strokeWidth=1;spacing=17;size=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="235" width="410" height="295" />
        </mxCell>
        <mxCell id="permission-note" value="&lt;div style=&quot;font-size:19px;font-weight:bold;color:#24496B;margin-bottom:10px&quot;&gt;公开与本人／后台权限&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;科研人员继承普通用户的公开查询能力。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;本人管理统计仅本人可见；质量与更新仅管理员。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;管理员亦可访问公开页面，图中突出后台权限。&lt;/div&gt;" style="fontFamily=Microsoft YaHei;fontColor=#26364A;shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#A7B4C1;strokeWidth=1;spacing=17;size=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="560" width="410" height="165" />
        </mxCell>
        <mxCell id="update-note" value="&lt;div style=&quot;font-size:19px;font-weight:bold;color:#24496B;margin-bottom:10px&quot;&gt;统计更新&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;认领、撤销、修订后标记统计待更新。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;更新失败保留上一成功快照。&lt;/div&gt;" style="fontFamily=Microsoft YaHei;fontColor=#26364A;shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#A7B4C1;strokeWidth=1;spacing=17;size=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="1110" width="410" height="135" />
        </mxCell>
        <mxCell id="legend" value="图例：实线＝参与者关联；空心三角实线＝角色泛化（指向一般角色）。图中连线不表示执行先后。" style="fontFamily=Microsoft YaHei;fontColor=#26364A;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#5B6C7E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">

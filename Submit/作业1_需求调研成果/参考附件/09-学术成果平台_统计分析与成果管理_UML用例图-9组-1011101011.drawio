        <mxCell id="edge-12" value="«include»" style="html=1;rounded=0;strokeColor=#5B6C7E;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#26364A;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;endSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="UC-AM-05" target="UC-AM-12">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-17" />
          </mxGeometry>
        </mxCell>
        <mxCell id="scope-note" value="&lt;div style=&quot;font-size:19px;font-weight:bold;color:#24496B;margin-bottom:10px&quot;&gt;模块范围&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;统一管理论文、专利、项目、获奖。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;门户认领与身份认证是前置业务，&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;在门户／认证模块另行展开。&lt;/div&gt;" style="fontFamily=Microsoft YaHei;fontColor=#26364A;shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#A7B4C1;strokeWidth=1;spacing=17;size=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="235" width="330" height="150" />
        </mxCell>
        <mxCell id="rules-note" value="&lt;div style=&quot;font-size:19px;font-weight:bold;color:#24496B;margin-bottom:10px&quot;&gt;管理规则&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;科研人员仅改本人平台附加信息。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;元数据纠错与补录需管理员审核。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;撤销个人关联不删除共享成果。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;重要变更留审计，关联统计待刷新。&lt;/div&gt;" style="fontFamily=Microsoft YaHei;fontColor=#26364A;shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#A7B4C1;strokeWidth=1;spacing=17;size=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="625" width="330" height="215" />
        </mxCell>
        <mxCell id="collection-note" value="&lt;div style=&quot;font-size:19px;font-weight:bold;color:#24496B;margin-bottom:10px&quot;&gt;跨模块协作&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;缺失论文转交采集模块补采。&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.6;margin-top:5px&quot;&gt;审核通过与采集完成是不同状态。&lt;/div&gt;" style="fontFamily=Microsoft YaHei;fontColor=#26364A;shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#A7B4C1;strokeWidth=1;spacing=17;size=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="1130" width="330" height="120" />
        </mxCell>
        <mxCell id="legend" value="图例：实线＝参与者关联；«include» 虚线箭头指向每次必执行的被包含用例。" style="fontFamily=Microsoft YaHei;fontColor=#26364A;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#5B6C7E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="1338" width="1740" height="32" />
        </mxCell>
        <mxCell id="sequence-note" value="提交申请与审核是独立用例，不用 include 表示先后。依据：甲方任务书第 1、4 页；SRS v0.1 §14.4／14.6；调研报告 v0.2 §9。" style="fontFamily=Microsoft YaHei;fontColor=#26364A;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#5B6C7E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="1380" width="1740" height="32" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
        <mxCell id="source" value="依据：甲方任务书正文第 1、4、8 页；SRS v0.1 §14.11；需求调研报告 v0.2 §8。补齐项均为评审建议。" style="fontFamily=Microsoft YaHei;fontColor=#26364A;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#5B6C7E;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">

        </mxCell>

        <!-- 待审核 -> 已驳回 -->
        <mxCell id="e7" value="驳回并记录原因" style="endArrow=classic;html=1;strokeColor=#445566;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pending" target="rejected">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 待审核 -> 已撤回 -->
        <mxCell id="e8" value="申请人撤回" style="endArrow=classic;html=1;strokeColor=#445566;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="pending" target="withdrawn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 待补充自环：校验失败 -->
        <mxCell id="e9" value="校验失败" style="endArrow=classic;html=1;strokeColor=#445566;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.25;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="supplement" target="supplement">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1060" y="340"/>
              <mxPoint x="1060" y="325"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 待补充 -> 待审核 -->
        <mxCell id="e10" value="补交且校验通过" style="endArrow=classic;html=1;strokeColor=#445566;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="supplement" target="pending">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 待补充 -> 已撤回 -->
        <mxCell id="e11" value="申请人撤回" style="endArrow=classic;html=1;strokeColor=#445566;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="supplement" target="withdrawn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 三个终态 -> end -->
        <mxCell id="e12" value="" style="endArrow=classic;html=1;strokeColor=#445566;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="approved" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="" style="endArrow=classic;html=1;strokeColor=#445566;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rejected" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="" style="endArrow=classic;html=1;strokeColor=#445566;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="withdrawn" target="end">
          <mxGeometry relative="1" as="geometry"/>

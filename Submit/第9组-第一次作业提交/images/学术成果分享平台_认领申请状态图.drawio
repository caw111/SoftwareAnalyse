        <!-- 待审核 -> 待补充 -->
        <mxCell id="e5" value="要求补充" style="endArrow=classic;html=1;strokeColor=#445566;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="pending" target="supplement">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 待审核 -> 已通过 -->

        <!-- 备注 -->
        <mxCell id="note" value="申请通过后，平台按有效绑定关系管理权限。&#10;后续权限撤销由独立流程处理。&#10;再次申请时，平台新建编号并保留历史记录。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#d4b86a;align=left;verticalAlign=middle;size=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="680" height="110" as="geometry"/>
        </mxCell>

      </root>

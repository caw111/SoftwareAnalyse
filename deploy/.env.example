# Copy to .env and replace the two passwords before starting. Do not commit .env.
DB_PASSWORD=replace-with-random-database-password
ADMIN_PASSWORD=replace-with-random-admin-password-16-characters-minimum

# The worker executes explicitly started tasks; source schedules are disabled by default.
CRAWL_WORKER_ENABLED=true
CRAWL_POLL_MS=2000
# Optional real maintainer mailbox for Crossref contact; leave blank if unconfigured.
CRAWL_CONTACT_EMAIL=

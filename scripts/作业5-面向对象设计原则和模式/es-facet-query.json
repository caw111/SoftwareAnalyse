{
  "size": 20,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "dataset": "real"
          }
        },
        {
          "term": {
            "release_revision": 42
          }
        }
      ],
      "must": [
        {
          "multi_match": {
            "query": "图神经网络",
            "fields": [
              "title^4",
              "author_names^2.5",
              "venue_name^2",
              "abstract",
              "discipline_labels^2"
            ]
          }
        }
      ]
    }
  },
  "post_filter": {
    "bool": {
      "filter": [
        {
          "terms": {
            "type": [
              "PAPER"
            ]
          }
        },
        {
          "range": {
            "publish_year": {
              "gte": 2020,
              "lte": 2026
            }
          }
        },
        {
          "terms": {
            "discipline_ids": [
              "CS"
            ]
          }
        }
      ]
    }
  },
  "sort": [
    {
      "_score": "desc"
    },
    {
      "work_id": "asc"
    }
  ],
  "aggs": {
    "type": {
      "filter": {
        "bool": {
          "filter": [
            {
              "range": {
                "publish_year": {
                  "gte": 2020,
                  "lte": 2026
                }
              }
            },
            {
              "terms": {
                "discipline_ids": [
                  "CS"
                ]
              }
            }
          ]
        }
      },
      "aggs": {
        "values": {
          "terms": {
            "field": "type",
            "size": 4,
            "show_term_doc_count_error": true
          }
        }
      }
    },
    "publish_year": {
      "filter": {
        "bool": {
          "filter": [
            {
              "terms": {
                "type": [
                  "PAPER"
                ]
              }
            },
            {
              "terms": {
                "discipline_ids": [
                  "CS"
                ]
              }
            }
          ]
        }
      },
      "aggs": {
        "values": {
          "histogram": {
            "field": "publish_year",
            "interval": 1,
            "min_doc_count": 1
          }
        }
      }
    },
    "discipline_ids": {
      "filter": {
        "bool": {
          "filter": [
            {
              "terms": {
                "type": [
                  "PAPER"
                ]
              }
            },
            {
              "range": {
                "publish_year": {
                  "gte": 2020,
                  "lte": 2026
                }
              }
            }
          ]
        }
      },
      "aggs": {
        "values": {
          "terms": {
            "field": "discipline_ids",
            "size": 20,
            "show_term_doc_count_error": true
          }
        }
      }
    },
    "institution_ids": {
      "filter": {
        "bool": {
          "filter": [
            {
              "terms": {
                "type": [
                  "PAPER"
                ]
              }
            },
            {
              "range": {
                "publish_year": {
                  "gte": 2020,
                  "lte": 2026
                }
              }
            },
            {
              "terms": {
                "discipline_ids": [
                  "CS"
                ]
              }
            }
          ]
        }
      },
      "aggs": {
        "values": {
          "terms": {
            "field": "institution_ids",
            "size": 20,
            "show_term_doc_count_error": true
          }
        }
      }
    }
  }
}
